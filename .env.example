# 服务端
PORT=8787
DATABASE_PATH=./data/crypto.db
TIMEZONE=Asia/Shanghai
LOG_LEVEL=info

# 初始化账密（仅在 users 表为空时生效）
INIT_USERNAME=admin
INIT_PASSWORD=admin123456

# 启动参数：运行时配置优先走 Web UI / 数据库
# 这些只是默认值，登录后请到 Web UI 修改
TG_BOT_TOKEN=
TG_CHAT_ID=
FEISHU_WEBHOOK_URL=

# === 飞书自建应用 Bot（可选，不填则降级到 webhook 纯文本推送） ===
# 飞书 SDK 长连接（WS）模式：本地开发不需要公网 URL / ngrok
# 飞书开放平台 → 应用 → 凭证：https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 定时推送的目标 ID（chat_id 或 open_id）
FEISHU_DEFAULT_RECEIVE_ID=
# chat_id | open_id | union_id | email
FEISHU_DEFAULT_RECEIVE_ID_TYPE=chat_id

# === 以下字段仅 HTTP 回调模式需要，WS 模式可省略 ===
# 当前实现使用 WS 模式，因此这些字段填了也不会被使用
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=